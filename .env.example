# Flow2API upstream
FLOW2API_BASE_URL=http://127.0.0.1:8000
FLOW2API_API_KEY=replace-with-your-api-key

# MCP runtime
FLOW2API_MCP_URL_CACHE=1
FLOW2API_MCP_EXTERNAL_URL_PREFIX=http://127.0.0.1:8866

# Optional: local image directory for use_latest_user_image=true
# Windows Cherry Studio example:
# FLOW2API_MCP_IMAGE_DIR=%APPDATA%\CherryStudio\Data\Files
# Linux example:
# FLOW2API_MCP_IMAGE_DIR=/home/yourname/.config/CherryStudio/Data/Files

# Optional tuning
# FLOW2API_MCP_HISTORY_RECENT_SIZE=50
# FLOW2API_MCP_HISTORY_ARCHIVE_SIZE=2000
# FLOW2API_MCP_GENERATE_RETRY_COUNT=0
# FLOW2API_MCP_PROMPT_SUFFIX=
# FLOW2API_MCP_DEBUG=0
